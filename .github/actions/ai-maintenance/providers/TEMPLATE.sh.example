# shellcheck shell=bash
# Template for a new provider. Copy to providers/<name>.sh, where <name> is
# the provider's name in the key pool (for example "provider2"). It may use
# the helpers in lib.sh (ai_log, ai_npm_install, ai_report_effort) and
# these variables:
#
#   AI_TOOLS_DIR     install CLIs here (shared across attempts of one run;
#                    read-only during attempts)
#   AI_ATTEMPT_DIR   writable output directory of this attempt (outside the
#                    checkout)
#
# provider_install runs on the runner, without a key. provider_run runs in
# the attempt's container, as an unprivileged user, in a copy of the
# repository checkout, with Node.js on PATH; nothing else of the runner is
# visible there.

# Optional: extra extended regex (case-insensitive) for errors that mean
# "this key is exhausted, try the next one". The common patterns (429,
# quota, rate limit, 401, billing, overloaded, ...) always apply.
# shellcheck disable=SC2034 # read by run.sh
PROVIDER_EXHAUSTED_REGEX=''

# Install the CLI (idempotent). Pin a version.
provider_install() {
    ai_npm_install "$AI_TOOLS_DIR/provider2" "provider2-cli@1.2.3"
}

# provider_run KEY PROMPT_FILE FINAL_FILE MODEL OPTIONS_JSON EFFORT
#   KEY           the API key for this attempt; pass it only to the CLI
#   PROMPT_FILE   the full prompt (preamble + instructions)
#   FINAL_FILE    write the agent's final message here (the PR description)
#   MODEL         model to use, or empty for the CLI's default
#   OPTIONS_JSON  the pool entry's options, e.g. {"base_url": "..."}
#   EFFORT        low | medium | high | xhigh | max, or empty for the CLI's
#                 default; map it onto the CLI's own levels, and call
#                 `ai_report_effort LEVEL` when the CLI runs with another
# Print progress to stdout/stderr (it becomes the attempt log) and return
# 0 only when the agent finished its task.
provider_run() {
    local key=$1 prompt=$2 final=$3 model=$4 options=$5 effort=${6:-} base_url
    base_url=$(jq -r '.base_url // ""' <<<"$options")
    PROVIDER2_API_KEY="$key" PROVIDER2_BASE_URL="$base_url" "$AI_TOOLS_DIR/provider2/node_modules/.bin/provider2" \
        --prompt-file "$prompt" ${model:+--model "$model"} ${effort:+--reasoning "$effort"} --yes --last-message "$final"
}
