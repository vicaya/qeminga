# qeminga: minimum secure subset of the QEMU guest agent (design §8.4, C-20).
#
# The daemon starts as root to open the channel, then drops to the
# `qeminga` account and installs seccomp itself (design §5.4, §5.5), so
# no User= or NoNewPrivileges= here. RuntimeDirectory= provisions
# /run/qeminga for the recovery marker; because there is no User=, systemd
# creates it root-owned, so ExecStartPre hands it to the service account
# before the drop (the marker is created after the drop, §4.4).
# RuntimeDirectoryPreserve=yes keeps it across stops so a marker survives
# (§5.7). TimeoutStopSec must exceed fsfreeze_max_timeout_secs plus a
# thaw-drain margin (300 + 30).
#
# The unit deliberately does not bind to the virtio port's device unit:
# recovery after a crash while frozen must not wait for the channel
# (§4.4, §5.7, OQ-7). The daemon makes one privileged open attempt, and
# its reopen loop retries with backoff once the device appears; with a
# BindsTo=/After= on the device, systemd would hold the whole service, and
# the recovery watchdog with it, for as long as the device is missing.

[Unit]
Description=qeminga QEMU guest agent (minimum secure subset)
Documentation=https://github.com/vicaya/qeminga
Conflicts=qemu-guest-agent.service
After=qemu-guest-agent.service
Before=multi-user.target

[Service]
Type=simple
ExecStartPre=+/usr/bin/chown qeminga:qeminga /run/qeminga
ExecStart=/usr/bin/qeminga --config /etc/qeminga/config.toml
Restart=always
RestartSec=1s
TimeoutStopSec=330s
RuntimeDirectory=qeminga
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StandardOutput=null
StandardError=journal
# Only what the startup sequence needs before its own drop (§5.4): open
# the 0600 qeminga-owned channel as root (DAC_OVERRIDE), change identity
# (SETUID/SETGID), trim the bounding set (SETPCAP), and the final three.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_BOOT CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID CAP_SETPCAP
AmbientCapabilities=
# Hardening that does not interfere with FIFREEZE on the real mount table.
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
PrivateTmp=no
ProtectHome=no
ProtectSystem=no

[Install]
WantedBy=multi-user.target
