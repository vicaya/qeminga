# qeminga: minimum secure subset of the QEMU guest agent (design §8.4, C-20).
#
# The daemon starts as root to open the channel, then drops to the
# `qeminga` account and installs seccomp itself (design §5.4, §5.5), so
# no User= or NoNewPrivileges= here.
#
# /run/qeminga holds the recovery marker (§4.4). It is provisioned at boot
# by tmpfiles.d/qeminga.conf and, belt and braces, by the privileged
# ExecStartPre lines below, owned by the service account: the marker is
# created and removed after the drop, by uid 600. RuntimeDirectory= is
# deliberately not used: with no User= systemd would (re)apply root
# ownership to the directory before every ExecStart, undoing any hand-over
# and leaving the dropped daemon unable to create or remove the marker.
# Nothing removes the directory on stop, so a marker left by a forced stop
# makes the next start enter recovery mode (C-20, §5.7); a reboot clears
# /run and the kernel's freeze state together. TimeoutStopSec must exceed
# fsfreeze_max_timeout_secs plus a thaw-drain margin (300 + 30).
#
[Unit]
Description=qeminga QEMU guest agent (minimum secure subset)
Documentation=https://github.com/vicaya/qeminga
Conflicts=qemu-guest-agent.service
After=qemu-guest-agent.service
Before=multi-user.target

[Service]
Type=simple
ExecStartPre=+/usr/bin/mkdir -p /run/qeminga
ExecStartPre=+/usr/bin/chown qeminga:qeminga /run/qeminga
ExecStartPre=+/usr/bin/chmod 0700 /run/qeminga
ExecStart=/usr/bin/qeminga --config /etc/qeminga/config.toml
Restart=always
RestartSec=1s
TimeoutStopSec=330s
StandardOutput=null
StandardError=journal
# Only what the startup sequence needs before its own drop (§5.4, §5.9): open
# the 0600 qeminga-owned channel as root (DAC_OVERRIDE), change identity
# (SETUID/SETGID), trim the bounding set (SETPCAP), and the final capabilities
# (CAP_SYS_ADMIN and CAP_DAC_READ_SEARCH always; CAP_SYS_BOOT kept only when
# [features] shutdown = true and dropped by the daemon under the CVM profile).
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_BOOT CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID CAP_SETPCAP
AmbientCapabilities=
# Hardening that does not interfere with FIFREEZE on the real mount table.
# ProtectSystem=strict remounts the filesystem hierarchy read-only
# (MNT_READONLY, not SB_RDONLY), so FIFREEZE/FITHAW/FITRIM on
# O_RDONLY|O_DIRECTORY descriptors still work while ordinary files outside
# /run/qeminga cannot be modified or unlinked even if writable to uid 600.
# /run/qeminga sits directly under root-owned /run so ExecStartPre=+ cannot
# be redirected across an untrusted ancestor; ReadWritePaths=-/run/qeminga
# carries the leading `-` so ExecStartPre=+ can create /run/qeminga on cold
# start before systemd evaluates the write exception for ExecStart (without
# `-`, a missing directory fails ExecStartPre=+ with 226/NAMESPACE).
# BindReadOnlyPaths=/sys /dev and ReadOnlyPaths=/run close the systemd
# MountAPIVFS quirk where ProtectKernelTunables=yes leaves /sys and /run
# writable when already mounted, AND recursively lock ordinary files on
# /dev itself plus every filesystem already mounted beneath /dev (/dev/shm,
# /dev/mqueue, /dev/hugepages, etc.) as MNT_READONLY while keeping existing
# character devices (/dev/virtio-ports/org.qemu.guest_agent.0, PTYs)
# openable O_RDWR and still letting an explicit suspend drop-in punch
# ReadWritePaths=/sys/power/state. ProtectHome=read-only locks /home,
# /root, and /run/user read-only (which ProtectSystem=strict leaves to
# ProtectHome=) without hiding separate /home mounts from the freeze
# plan. SystemCallFilter=~@mount prevents undoing the read-only mount
# namespace even while CAP_SYS_ADMIN is held. PrivateTmp=no is deliberate
# so /tmp and /var/tmp are not overmounted with writable private tmpfs.
ProtectSystem=strict
ReadWritePaths=-/run/qeminga
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
BindReadOnlyPaths=/sys /dev
ReadOnlyPaths=/run
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=~@mount
UMask=0077
PrivateTmp=no
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
